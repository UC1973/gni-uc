# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 사이트 주소 (메일 링크용) — 예: https://gni-uc.vercel.app
NEXT_PUBLIC_SITE_URL=https://gni-uc.org

# Resend (가입 접수·승인 메일)
RESEND_API_KEY=
RESEND_FROM="GNI-UC 산업AX전공 <no-reply@gni-uc.org>"
# 새 가입 신청 알림을 받을 사업단 이메일 (쉼표로 구분)
ADMIN_NOTIFY_EMAILS=
# 가입 허용 이메일 도메인 (비우면 제한 없음) — 예: uc.ac.kr,kimhae.ac.kr
ALLOWED_EMAIL_DOMAINS=

# AI (OpenAI 호환 API)
OPENAI_API_KEY=
AI_MODEL=gpt-6.1-terra
# OPENAI_BASE_URL=
