# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 사이트 주소 (메일 링크용) — 예: https://gni-uc.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend (가입 접수·승인 메일)
RESEND_API_KEY=
RESEND_FROM="GNI-UC <no-reply@your-domain>"
# 새 가입 신청 알림을 받을 사업단 이메일 (쉼표로 구분)
ADMIN_NOTIFY_EMAILS=

# AI (OpenAI 호환 API)
OPENAI_API_KEY=
AI_MODEL=gpt-6.1-terra
# OPENAI_BASE_URL=
